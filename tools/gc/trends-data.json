  "trends": [
    { "id":"radius",   "name":"Atomic radius",        "unit":"pm",     "direction":"radius: ↓ across, ↑ down", "reason":"Across a period Z_eff rises and pulls the same shell tighter; down a group a new shell is added each row.", "scale":"low_is_small", "decimals":0 },
    { "id":"ie1",      "name":"First ionization energy","unit":"kJ/mol","direction":"IE: ↑ across, ↓ down",      "reason":"Smaller atoms with higher Z_eff hold their valence electron tighter; larger atoms shed it more easily.",     "scale":"high_is_strong", "decimals":0 },
    { "id":"en",       "name":"Electronegativity",    "unit":"Pauling","direction":"EN: ↑ across, ↓ down",      "reason":"EN tracks IE and EA — small, high-Z_eff atoms pull bonding electrons harder.",                              "scale":"high_is_strong", "decimals":2 },
    { "id":"ea",       "name":"Electron affinity",    "unit":"kJ/mol", "direction":"EA: ↑ exothermic across, ↓ down (with exceptions)", "reason":"More negative = more energy released when adding an electron. Sign convention: exothermic is reported as negative.","scale":"low_is_strong", "decimals":1 },
    { "id":"metallic", "name":"Metallic character",   "unit":"qual 1–10","direction":"Metallic: ↓ across, ↑ down","reason":"Metallic character tracks low IE / low EN — atoms that lose electrons easily.",                          "scale":"high_is_strong", "decimals":0 },
    { "id":"mass",     "name":"Atomic mass",          "unit":"u",      "direction":"Mass: ↑ across, ↑ down (mostly)", "reason":"Mass scales with Z plus average neutron count; baseline view to compare against the others.",          "scale":"high_is_strong", "decimals":2 }
  ],

  "anomalies": [
    {
      "id": "g13_ie_drop",
      "rule": "Group 13 IE drops below Group 2",
      "examples": [["Be","B"], ["Mg","Al"], ["Ca","Ga"]],
      "explanation": "Group 13's outermost electron sits in a higher-energy np orbital while Group 2's is in ns. The np electron is shielded by the full ns² and easier to remove, so IE actually drops despite Z increasing."
    },
    {
      "id": "g16_ie_drop",
      "rule": "Group 16 IE drops below Group 15",
      "examples": [["N","O"], ["P","S"], ["As","Se"]],
      "explanation": "Group 15 has a half-filled np³ — extra stability. Group 16 must pair an electron in one np orbital, and that pair-pair repulsion makes the first electron easier to remove."
    },
    {
      "id": "ea_cl_gt_f",
      "rule": "Cl has greater EA magnitude than F",
      "examples": [["F","Cl"]],
      "explanation": "F's 2p orbitals are tiny and packed — adding an electron forces high electron-electron repulsion. Cl's larger 3p hosts the new electron with less repulsion, so −349 kJ/mol (Cl) is more exothermic than −328 kJ/mol (F)."
    },
    {
      "id": "ea_g2_zero",
      "rule": "Group 2 EA is essentially zero",
      "examples": [["Be","Li"], ["Mg","Na"]],
      "explanation": "Group 2 has a filled ns² subshell. Adding an electron forces it into a higher-energy np orbital — not favorable. The process is reported as ~0 kJ/mol."
    },
    {
      "id": "ea_g15_zero",
      "rule": "Group 15 EA is near zero",
      "examples": [["N","C"], ["P","Si"]],
      "explanation": "Half-filled np³ is stable. Adding an electron means pairing — the energy cost roughly cancels the stabilization, leaving EA near zero (N is +7 kJ/mol)."
    },
    {
      "id": "ea_noble_zero",
      "rule": "Noble gas EA is zero (no electron added)",
      "examples": [["Ne","F"], ["Ar","Cl"]],
      "explanation": "Noble gases have a closed shell. Adding an electron requires starting a new, higher-energy shell. EA is reported as 0."
    },
    {
      "id": "lanthanide_contraction",
      "rule": "Lanthanide contraction — period-6 d-block atoms are nearly the same size as period-5",
      "examples": [["Zr","Hf"], ["Nb","Ta"], ["Mo","W"]],
      "explanation": "After filling 4f¹⁴, the poor shielding of f-electrons leaves a higher effective Z. Period-6 d-block radii do not grow as expected — Hf ≈ Zr, Ta ≈ Nb. Often catches students who assume 'down a group is always bigger.'"
    },
    {
      "id": "transition_radius_flat",
      "rule": "Transition-metal radius is nearly flat across a period",
      "examples": [["Ti","Fe"], ["Cr","Ni"]],
      "explanation": "Across the d-block the new electron fills an inner d-orbital that shields the outermost s-electrons fairly well. Z rises but Z_eff at the outer shell barely changes, so radius shrinks only slightly."
    },
    {
      "id": "cation_smaller",
      "rule": "Cations are smaller than parents; anions are larger",
      "examples": [["Na","Na⁺"], ["O","O²⁻"]],
      "explanation": "Removing an electron leaves the same Z pulling fewer e⁻ — tighter. Adding an electron raises e–e repulsion at the same Z — looser. Always: cation < parent < anion."
    },
    {
      "id": "h_position",
      "rule": "Hydrogen does not behave like Group 1 metals",
      "examples": [["Li","H"]],
      "explanation": "H's IE (1312) is far closer to F (1681) than to Li (520). Don't reflexively call H a metal — it sits in Group 1 by configuration only."
    }
  ],

  "isoelectronic_sets": [
    { "id":"iso10a", "n_electrons":10, "members":["O²⁻","F⁻","Ne","Na⁺","Mg²⁺","Al³⁺"], "ranked_by_radius":["O²⁻","F⁻","Ne","Na⁺","Mg²⁺","Al³⁺"], "logic":"All 10 e⁻. Z = 8, 9, 10, 11, 12, 13. More protons pull the same cloud tighter → smaller. Largest is O²⁻ (Z=8); smallest is Al³⁺ (Z=13)." },
    { "id":"iso10b", "n_electrons":10, "members":["N³⁻","O²⁻","F⁻","Na⁺","Mg²⁺"], "ranked_by_radius":["N³⁻","O²⁻","F⁻","Na⁺","Mg²⁺"], "logic":"10 e⁻ all. Anions first (low Z = bigger), cations last. N³⁻ is the largest because Z=7 holds fewest protons against the 10 electrons." },
    { "id":"iso10c", "n_electrons":10, "members":["F⁻","Ne","Na⁺","Mg²⁺"], "ranked_by_radius":["F⁻","Ne","Na⁺","Mg²⁺"], "logic":"Same Ne configuration. Increasing Z (9→12) tightens the cloud monotonically. The neutral atom Ne sits between the anion and cations, not at either extreme." },

    { "id":"iso18a", "n_electrons":18, "members":["S²⁻","Cl⁻","Ar","K⁺","Ca²⁺","Sc³⁺"], "ranked_by_radius":["S²⁻","Cl⁻","Ar","K⁺","Ca²⁺","Sc³⁺"], "logic":"18 e⁻ Ar-core. Z runs 16→21. Same logic as the Ne set, one shell out — S²⁻ largest, Sc³⁺ smallest." },
    { "id":"iso18b", "n_electrons":18, "members":["P³⁻","S²⁻","Cl⁻","K⁺","Ca²⁺"], "ranked_by_radius":["P³⁻","S²⁻","Cl⁻","K⁺","Ca²⁺"], "logic":"18 e⁻. P³⁻ has the lowest Z (15) and so the loosest grip; Ca²⁺ has Z=20 and pulls hardest." },
    { "id":"iso18c", "n_electrons":18, "members":["Cl⁻","Ar","K⁺","Ca²⁺"], "ranked_by_radius":["Cl⁻","Ar","K⁺","Ca²⁺"], "logic":"Anion → neutral → cations. Watch for the trap of putting Ar 'in the middle' for the wrong reason — it's in the middle because Z=18 sits between Cl(17) and K(19)." },

    { "id":"iso28a", "n_electrons":28, "members":["Fe²⁺","Co³⁺","Ni⁴⁺"], "ranked_by_radius":["Fe²⁺","Co³⁺","Ni⁴⁺"], "logic":"All 28 e⁻ in [Ar]3d⁶ region (Ni⁴⁺ depopulates 4s and one 3d). Z = 26, 27, 28. Higher Z + higher charge → tighter, smaller." },
    { "id":"iso28b", "n_electrons":28, "members":["Mn⁻","Fe","Co⁺","Ni²⁺"], "ranked_by_radius":["Mn⁻","Fe","Co⁺","Ni²⁺"], "logic":"All 28 e⁻. Z = 25→28. The anion Mn⁻ is largest because Z is lowest and the extra electron raises e–e repulsion." },

    { "id":"iso36a", "n_electrons":36, "members":["Se²⁻","Br⁻","Kr","Rb⁺","Sr²⁺","Y³⁺"], "ranked_by_radius":["Se²⁻","Br⁻","Kr","Rb⁺","Sr²⁺","Y³⁺"], "logic":"36 e⁻ Kr-core. Z = 34→39. Pure Z_eff ranking — the period-4 analog of the Ne and Ar sets." },
    { "id":"iso36b", "n_electrons":36, "members":["Br⁻","Kr","Rb⁺","Sr²⁺"], "ranked_by_radius":["Br⁻","Kr","Rb⁺","Sr²⁺"], "logic":"36 e⁻. Standard sequence — anion biggest, doubly-charged cation smallest." },

    { "id":"iso2a",  "n_electrons":2,  "members":["H⁻","He","Li⁺","Be²⁺"], "ranked_by_radius":["H⁻","He","Li⁺","Be²⁺"], "logic":"2 e⁻ in 1s². Z = 1→4. H⁻ is enormous (the two electrons share a single proton); Be²⁺ is tiny." },
    { "id":"iso54a", "n_electrons":54, "members":["Te²⁻","I⁻","Xe","Cs⁺","Ba²⁺"], "ranked_by_radius":["Te²⁻","I⁻","Xe","Cs⁺","Ba²⁺"], "logic":"54 e⁻ Xe-core. Same recipe applied to period 5: anions biggest, cations smallest, Z_eff is the only knob." }
  ],

