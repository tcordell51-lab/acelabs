    { "id":"d_g13_MgAl", "trend":"ie1",      "a":"Mg", "b":"Al", "winner":"Mg", "reason":"Group 13 IE drop: Al's 3p electron is shielded by 3s² and easier to remove.",      "anomaly":"g13_ie_drop" },
    { "id":"d_g13_CaGa", "trend":"ie1",      "a":"Ca", "b":"Ga", "winner":"Ca", "reason":"Same drop, period 4. Ga (4p) loses its electron more easily than Ca (4s²).",       "anomaly":"g13_ie_drop" },
    { "id":"d_g16_NO",   "trend":"ie1",      "a":"N",  "b":"O",  "winner":"N",  "reason":"Group 16 IE drop: O must pair its 4th 2p electron — pair repulsion makes it easier to lose.", "anomaly":"g16_ie_drop" },
    { "id":"d_g16_PS",   "trend":"ie1",      "a":"P",  "b":"S",  "winner":"P",  "reason":"P has half-filled 3p³; S pays the pairing cost on the 4th 3p electron.",            "anomaly":"g16_ie_drop" },
    { "id":"d_g16_AsSe", "trend":"ie1",      "a":"As", "b":"Se", "winner":"As", "reason":"Same half-fill argument in period 4.",                                              "anomaly":"g16_ie_drop" },
    { "id":"d_eaClF",    "trend":"ea_mag",   "a":"Cl", "b":"F",  "winner":"Cl", "reason":"F's 2p is so small that adding an electron costs serious e–e repulsion. Cl's 3p hosts the new electron more comfortably (−349 vs −328 kJ/mol).", "anomaly":"ea_cl_gt_f" },
    { "id":"d_eaBrF",    "trend":"ea_mag",   "a":"Br", "b":"F",  "winner":"F",  "reason":"Magnitude comparison — F still beats Br (−328 vs −325). Cl is the real exception, not all halogens.", "anomaly":"ea_cl_gt_f" },
    { "id":"d_eaBeLi",   "trend":"ea_mag",   "a":"Be", "b":"Li", "winner":"Li", "reason":"Be has filled 2s² — the new electron would have to enter 2p. EA ≈ 0 for Be.",          "anomaly":"ea_g2_zero" },
    { "id":"d_eaMgNa",   "trend":"ea_mag",   "a":"Mg", "b":"Na", "winner":"Na", "reason":"Mg has filled 3s². Na (3s¹) gladly accepts another 3s electron.",                     "anomaly":"ea_g2_zero" },
    { "id":"d_eaNC",     "trend":"ea_mag",   "a":"N",  "b":"C",  "winner":"C",  "reason":"N's 2p³ is half-filled — the 4th electron would pair. EA goes positive (+7).",        "anomaly":"ea_g15_zero" },
    { "id":"d_eaNeF",    "trend":"ea_mag",   "a":"Ne", "b":"F",  "winner":"F",  "reason":"Ne has a closed shell. Its EA is reported as 0; F's is −328.",                       "anomaly":"ea_noble_zero" },
    { "id":"d_eaArCl",   "trend":"ea_mag",   "a":"Ar", "b":"Cl", "winner":"Cl", "reason":"Ar = closed shell → EA 0. Cl is the most exothermic-EA element on the table.",        "anomaly":"ea_noble_zero" },
    { "id":"d_lanZrHf",  "trend":"radius",   "a":"Zr", "b":"Hf", "winner":"Zr", "reason":"Lanthanide contraction: poor 4f shielding makes Hf nearly identical to Zr — but Zr is still slightly larger.", "anomaly":"lanthanide_contraction" },
    { "id":"d_lanNbTa",  "trend":"radius",   "a":"Nb", "b":"Ta", "winner":"Nb", "reason":"Lanthanide contraction strikes again. Nb (period 5) is barely bigger than Ta (period 6).", "anomaly":"lanthanide_contraction" },
    { "id":"d_lanMoW",   "trend":"radius",   "a":"Mo", "b":"W",  "winner":"Mo", "reason":"Same effect: W and Mo are essentially the same size. Most students predict W bigger by a lot.", "anomaly":"lanthanide_contraction" },
    { "id":"d_tmTiCu",   "trend":"radius",   "a":"Ti", "b":"Cu", "winner":"Ti", "reason":"Across the d-block radii barely shrink because filled inner d shields the 4s. Ti is only slightly larger than Cu.", "anomaly":"transition_radius_flat" },
    { "id":"d_tmFeNi",   "trend":"radius",   "a":"Fe", "b":"Ni", "winner":"Fe", "reason":"d-block radii are nearly flat — but the trend still goes the textbook direction.",   "anomaly":"transition_radius_flat" },
    { "id":"d_hLi",      "trend":"ie1",      "a":"H",  "b":"Li", "winner":"H",  "reason":"H's IE is 1312 — far higher than Li's 520. H is not metallic in behavior.",            "anomaly":"h_position" },
    { "id":"d_hF",       "trend":"ie1",      "a":"F",  "b":"H",  "winner":"F",  "reason":"H sits closer to F (1681) than to Li (520) on IE — but F still wins.",                "anomaly":"h_position" },

